# phaedrus site config — annotated reference. The committed example.
# Real configs live at sites/<key>.env and are gitignored. Generate with `make configure`.
# Defaults shown below are the Kindness Flywheel values (the seed site).

# ===== Site identity =====            DEFAULT (Kindness Flywheel)
SITE_NAME="Kindness Flywheel"
SITE_URL="https://kindnessflywheel.org"
SITE_ORIGIN="https://kindnessflywheel.org"   # = SITE_URL (ALLOWED_ORIGIN for the OAuth popup)

# ===== Content repo =====
GH_OWNER="kindnessflywheel"                  # org/user owning the CONTENT repo
CONTENT_REPO="kindnessflywheel-site"          # name of the CONTENT repo (don't use GH_REPO — collides with gh CLI's env var)
GH_BRANCH="main"
GH_VISIBILITY="public"                       # public => scope public_repo ; private => repo

# ===== GCP =====
GCP_REGION="us-central1"
NAME_PREFIX="kindnessflywheel"               # unique per site; namespaces all resources

# ===== Custom domains (optional) =====
# One custom subdomain per service via plain Cloud Run domain mappings (no LB).
# Either/both/neither. When set, `make deploy-domain` creates the mapping and
# prints the CNAME to add in Cloudflare as DNS-only (grey cloud). AUTH_DOMAIN
# also re-points the proxy's BASE_URL — update the GitHub OAuth App callback to
# https://<AUTH_DOMAIN>/callback. See docs/spec-a-oauth-proxy.md.
MCP_DOMAIN=""                                # e.g. mcp.kindnessflywheel.org  -> https://mcp.../mcp
AUTH_DOMAIN=""                               # e.g. auth.kindnessflywheel.org -> OAuth proxy

# ===== Content conventions (Jekyll / Minimal Mistakes defaults) =====
POSTS_DIR="_posts"
AUTHORS_DIR="_authors"
AUTHORS_DATA="_data/authors.yml"
IMAGES_DIR="assets/images/posts"
LLMS_TXT="llms.txt"

# ===== Tags =====
# The curated tag vocabulary lives in the content repo at _data/tags.yml (PR-gated,
# read at runtime by Decap, the MCP server, and check_new_tags.py). INITIAL_TAGS only
# seeds that file on first install if it doesn't exist yet; it's not used afterwards.
INITIAL_TAGS="Strategy,People,Technology,Practice,Meta"       # optional first-install seed (comma-separated)
